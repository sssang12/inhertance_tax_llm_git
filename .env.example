# 국가법령정보 공동활용 OpenAPI 키 (https://open.law.go.kr/LSO/openApi/guideList.do)
LAW_API_KEY=your_law_go_kr_oc_id

# 교사 모델 API (합성 instruction 생성용)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face (Llama 3.1 다운로드)
HF_TOKEN=hf_...

# W&B (선택)
WANDB_API_KEY=
WANDB_PROJECT=inheritance-tax-llm

# 학습 데이터 저장 경로 (기본값: ./data)
DATA_ROOT=./data
MODEL_OUTPUT_DIR=./outputs/checkpoints
